# ======================================================================
#  Configuration du serveur IRC
#
#  Ce fichier est un modele. setup.bat le copie en .env et renseigne les
#  valeurs en posant des questions : vous n'avez normalement rien a
#  editer ici a la main.
#
#  A savoir si vous editez le .env directement :
#   - les valeurs sont prises telles quelles, sans guillemets ;
#   - une valeur contenant & ou " doit etre evitee dans les mots de passe
#     et les topics : elle part dans une configuration XML cote serveur
#     (setup.bat echappe les topics, pas les mots de passe) ;
#   - un $ est pire : docker compose developpe $NOM dans les valeurs du
#     .env, le serveur recoit donc une chaine tronquee pendant que les
#     scripts (invitation, compte pre-rempli) utilisent le texte brut ;
#   - apres modification :
#         docker compose up -d --force-recreate irc webclient
#         docker compose restart tor
#     Le "restart tor" n'est pas facultatif : un conteneur recree a une
#     nouvelle IP, et tor ne la resout qu'a son propre demarrage.
# ======================================================================

# --- Reseau IRC ---
IRC_NETWORK_NAME=MonReseau
IRC_NET_SUFFIX=.irc.local

# --- Admin ---
ADMIN_NAME=admin
ADMIN_NICK=Admin
ADMIN_EMAIL=admin@localhost

# Mot de passe demande pour se connecter au serveur (vide = aucun).
# Il est partage par tous les utilisateurs et se retrouve en clair dans le
# package client distribue : ce n'est plus le controle d'acces principal,
# c'est le compte The Lounge (scripts\add-user.bat) qui l'est.
#
# NE PAS mettre une valeur entierement numerique (ni ici, ni dans
# IRC_NETWORK_NAME) : elle est passee a The Lounge par "-c cle=valeur",
# qui la convertit en nombre, et la configuration la rejette alors
# ("Incorrect type for password"). Le formulaire partirait avec un mot de
# passe vide et la connexion echouerait sans message. Au moins une lettre.
CONNECT_PASSWORD=CHANGEME

# Mot de passe administrateur, utilise par la commande IRC :
#   /OPER admin VOTRE_MOT_DE_PASSE
# Il est stocke en clair ici (OPER_HASH=plaintext), comme CONNECT_PASSWORD.
# Pour le stocker hashe : une fois connecte et oper, tapez
#   /MKPASSWD bcrypt VOTRE_MOT_DE_PASSE
# collez le resultat dans OPER_PASSWORD et mettez OPER_HASH=bcrypt.
# (L'ancienne methode "inspircd --mkpasswd hmac-sha256" ne fonctionne
#  plus : l'option a disparu avec InspIRCd 4.)
OPER_PASSWORD=CHANGEME
OPER_HASH=plaintext

# --- Channel par defaut ---
# Cree automatiquement au demarrage, avec son topic, et conserve meme
# quand il est vide.
DEFAULT_CHANNEL=DEFAULTCHANNEL
DEFAULT_TOPIC=Bienvenue sur le serveur IRC !

# --- Services optionnels ---
# Profils docker compose actives en permanence (separes par des virgules) :
#   proxy = proxy Tor local (deconseille : image non maintenue)
# Vide = serveur IRC + service cache Tor + interface web.
#
# L'interface web n'est plus un profil : l'adresse .onion la publie
# (HiddenServicePort 80), c'est devenu la porte d'entree principale.
COMPOSE_PROFILES=

# --- Interface web ---
# Port LOCAL de confort pour l'administrateur (http://localhost:PORT),
# lie a 127.0.0.1. Les utilisateurs, eux, passent par http://<onion>/.
WEBCLIENT_PORT=8080

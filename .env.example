# ======================================================
#  Configuration IRC — copiez en .env et adaptez
# ======================================================

# --- Réseau IRC ---
IRC_NETWORK_NAME=MonReseau
IRC_NET_SUFFIX=.irc.local

# --- Admin ---
ADMIN_NAME=admin
ADMIN_NICK=Admin
ADMIN_EMAIL=admin@localhost

# Mot de passe pour se connecter au serveur IRC (laissez vide = pas de mot de passe)
CONNECT_PASSWORD=

# Mot de passe oper hashé en hmac-sha256
# Générez-le avec :
#   docker run --rm inspircd/inspircd-docker:latest /inspircd/bin/inspircd --mkpasswd hmac-sha256 VOTRE_MOT_DE_PASSE
# Puis copiez le hash ici (sans le préfixe "Password: ")
OPER_PASSWORD_HASH=CHANGEME

# --- Channel par défaut ---
DEFAULT_CHANNEL=#general
DEFAULT_TOPIC=Bienvenue sur le serveur IRC !

# --- Web client ---
WEBCLIENT_PORT=8080
